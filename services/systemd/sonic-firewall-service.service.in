[Unit]
Description=SonicDE firewall service
After=dbus.service polkit.service
Wants=polkit.service

[Service]
Type=simple
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/sonic-firewall-service
Restart=on-failure

[Install]
WantedBy=multi-user.target
