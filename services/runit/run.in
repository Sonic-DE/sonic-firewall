sv check dbus >/dev/null || exit 1
# Not captured: the daemon writes /var/log/sonic/sonic-firewall-service.log itself.
exec >/dev/null 2>&1
exec @KDE_INSTALL_FULL_LIBEXECDIR@/sonic-firewall-service
